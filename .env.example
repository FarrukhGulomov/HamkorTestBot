# Telegram bot token (@BotFather)
BOT_TOKEN=

# SQLite (default) yoki PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hamkor_bot
DATABASE_URL=sqlite+aiosqlite:///./hamkor_bot.db

# Oxirgi xabardan necha soniya o'tgach rozilik so'raladi (3 daqiqa = 180)
CONSENT_IDLE_SECONDS=180

# Rozilik uchun foydalanuvchilar necha soniyada bir tekshiriladi
CONSENT_CHECK_INTERVAL_SECONDS=5
